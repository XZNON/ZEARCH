{
  "name": "@zearch/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx ./src/index.ts",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --watch --import tsx ./src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@zearch/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
